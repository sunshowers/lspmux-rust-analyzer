#!/bin/bash
# Setup script for lspmux-rust-analyzer.
# Installs rust-analyzer, lspmux, and system services.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# XDG base directories with standard fallbacks.
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Installation directories.
RA_DIR="$XDG_DATA_HOME/lspmux-rust-analyzer"
RA_BIN_DIR="$RA_DIR/bin"
LSPMUX_CONFIG_DIR="$XDG_CONFIG_HOME/lspmux"
LOG_DIR="$XDG_STATE_HOME/lspmux-rust-analyzer"

# Colors for output.
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}warning:${NC} $*"; }
error() { echo -e "${RED}error:${NC} $*" >&2; }
die() { error "$*"; exit 1; }

# Detect platform.
detect_platform() {
    case "$(uname -s)" in
        Linux)  PLATFORM_OS="linux" ;;
        Darwin) PLATFORM_OS="macos" ;;
        *)      die "Unsupported OS: $(uname -s)" ;;
    esac

    case "$(uname -m)" in
        x86_64)  PLATFORM_ARCH="x86_64" ;;
        aarch64) PLATFORM_ARCH="aarch64" ;;
        arm64)   PLATFORM_ARCH="aarch64" ;;
        *)       die "Unsupported architecture: $(uname -m)" ;;
    esac

    info "Detected platform: $PLATFORM_OS-$PLATFORM_ARCH"
}

# Check for required tools.
check_dependencies() {
    local missing=()

    for cmd in curl jq cargo; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required tools: ${missing[*]}"
    fi
}

# Install update script to rust-analyzer data directory.
install_update_script() {
    info "Installing update script to $RA_BIN_DIR"

    mkdir -p "$RA_BIN_DIR"
    cp "$SCRIPT_DIR/bin/update-rust-analyzer" "$RA_BIN_DIR/update-rust-analyzer"
    chmod +x "$RA_BIN_DIR/update-rust-analyzer"

    UPDATE_SCRIPT="$RA_BIN_DIR/update-rust-analyzer"
}

# Download rust-analyzer.
install_rust_analyzer() {
    info "Downloading rust-analyzer"

    mkdir -p "$RA_DIR" "$LOG_DIR"

    if "$UPDATE_SCRIPT"; then
        local version
        version=$("$RA_DIR/current/rust-analyzer" --version 2>/dev/null || echo "unknown")
        info "rust-analyzer installed: $version"
    else
        die "Failed to download rust-analyzer"
    fi
}

# Install lspmux via cargo. Sets LSPMUX_BIN to the installed binary path.
install_lspmux() {
    info "Installing lspmux via cargo"

    if ! cargo install --locked lspmux; then
        die "Failed to install lspmux"
    fi

    # Find the installed lspmux binary.
    local cargo_home="${CARGO_HOME:-$HOME/.cargo}"
    LSPMUX_BIN="$cargo_home/bin/lspmux"

    if [[ ! -x "$LSPMUX_BIN" ]]; then
        # Fallback: check PATH.
        LSPMUX_BIN=$(command -v lspmux || true)
    fi

    if [[ -z "$LSPMUX_BIN" || ! -x "$LSPMUX_BIN" ]]; then
        die "lspmux installed but binary not found"
    fi

    local version
    version=$("$LSPMUX_BIN" --version 2>/dev/null || echo "unknown")
    info "lspmux installed: $version (at $LSPMUX_BIN)"
}

# Install lspmux configuration.
install_config() {
    info "Installing lspmux configuration to $LSPMUX_CONFIG_DIR"

    mkdir -p "$LSPMUX_CONFIG_DIR"
    cp "$SCRIPT_DIR/config/lspmux.toml" "$LSPMUX_CONFIG_DIR/config.toml"
}

# Install systemd services (Linux).
install_systemd_services() {
    local systemd_dir="$XDG_CONFIG_HOME/systemd/user"
    info "Installing systemd user services to $systemd_dir"

    mkdir -p "$systemd_dir"

    # lspmux server service.
    sed "s|LSPMUX_BIN_PLACEHOLDER|$LSPMUX_BIN|g" \
        "$SCRIPT_DIR/systemd/lspmux.service" \
        > "$systemd_dir/lspmux.service"

    # rust-analyzer update service.
    sed -e "s|UPDATE_SCRIPT_PLACEHOLDER|$UPDATE_SCRIPT|g" \
        -e "s|%h/.local/share|$XDG_DATA_HOME|g" \
        -e "s|%h/.local/state|$XDG_STATE_HOME|g" \
        "$SCRIPT_DIR/systemd/rust-analyzer-update.service" \
        > "$systemd_dir/rust-analyzer-update.service"

    cp "$SCRIPT_DIR/systemd/rust-analyzer-update.timer" "$systemd_dir/"

    systemctl --user daemon-reload

    info "Enabling and starting lspmux service"
    systemctl --user enable --now lspmux.service

    info "Enabling rust-analyzer update timer"
    systemctl --user enable --now rust-analyzer-update.timer
}

# Install launchd agents (macOS).
install_launchd_agents() {
    local agents_dir="$HOME/Library/LaunchAgents"
    local log_file="$LOG_DIR/update.log"
    local lspmux_log="$XDG_STATE_HOME/lspmux/server.log"

    info "Installing launchd agents to $agents_dir"

    mkdir -p "$agents_dir" "$LOG_DIR" "$(dirname "$lspmux_log")"

    # lspmux server agent.
    sed -e "s|LSPMUX_BIN_PLACEHOLDER|$LSPMUX_BIN|g" \
        -e "s|LSPMUX_LOG_PLACEHOLDER|$lspmux_log|g" \
        "$SCRIPT_DIR/launchd/com.lspmux.server.plist" \
        > "$agents_dir/com.lspmux.server.plist"

    # rust-analyzer update agent.
    sed -e "s|UPDATE_SCRIPT_PLACEHOLDER|$UPDATE_SCRIPT|g" \
        -e "s|UPDATE_LOG_PLACEHOLDER|$log_file|g" \
        "$SCRIPT_DIR/launchd/com.rust-analyzer.update.plist" \
        > "$agents_dir/com.rust-analyzer.update.plist"

    info "Loading lspmux server agent"
    launchctl unload "$agents_dir/com.lspmux.server.plist" 2>/dev/null || true
    launchctl load -w "$agents_dir/com.lspmux.server.plist"

    info "Loading rust-analyzer update agent"
    launchctl unload "$agents_dir/com.rust-analyzer.update.plist" 2>/dev/null || true
    launchctl load -w "$agents_dir/com.rust-analyzer.update.plist"
}

# Print Claude Code plugin instructions.
print_plugin_instructions() {
    echo
    info "Setup complete!"
    echo
    echo "To configure Claude Code, run:"
    echo "  claude plugin marketplace add $SCRIPT_DIR"
    echo "  claude plugin disable rust-analyzer-lsp@claude-plugins-official --scope user"
    echo "  claude plugin install lspmux-rust@lspmux-plugins --scope user"
    echo
    echo "Verify installation:"
    if [[ "$PLATFORM_OS" == "linux" ]]; then
        echo "  systemctl --user status lspmux"
        echo "  systemctl --user status rust-analyzer-update.timer"
    elif [[ "$PLATFORM_OS" == "macos" ]]; then
        echo "  launchctl list | grep lspmux"
        echo "  launchctl list | grep rust-analyzer"
    fi
    echo "  $RA_DIR/current/rust-analyzer --version"
}

main() {
    echo "lspmux-rust-analyzer setup"
    echo "=========================="
    echo
    echo "XDG directories:"
    echo "  XDG_DATA_HOME:   $XDG_DATA_HOME"
    echo "  XDG_CONFIG_HOME: $XDG_CONFIG_HOME"
    echo "  XDG_STATE_HOME:  $XDG_STATE_HOME"
    echo

    detect_platform
    check_dependencies

    install_update_script
    install_rust_analyzer
    install_lspmux
    install_config

    if [[ "$PLATFORM_OS" == "linux" ]]; then
        install_systemd_services
    elif [[ "$PLATFORM_OS" == "macos" ]]; then
        install_launchd_agents
    fi

    print_plugin_instructions
}

main "$@"
